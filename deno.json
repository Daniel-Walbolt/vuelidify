{
	"name": "@vuelidify/core",
	"version": "1.0.1",
	"license": "MIT",
	"exports": "./src/index.ts",
	"compilerOptions": {
		"types": [
			"node"
		]
	},
	"lint": {
		"exclude": ["test-ui/", "tests/", "*"]
	},
	"fmt": {
		"include": [
			"tests/",
			"src/"
		],
		"useTabs": true,
		"bracePosition": "sameLine",
		"lineWidth": 120,
		"semiColons": true,
		"singleQuote": false,
		"useBraces": "always"
	},
	"test": {
		"include": ["./tests/"]
	}
}